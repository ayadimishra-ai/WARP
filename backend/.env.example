# Copy to .env and fill in values — never commit .env

APP_ENV=local
APP_BASE_URL=http://localhost:8000
PARENT_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snowkap
DB_USER=postgres
DB_PASSWORD=

# Hasura (kept for subscriptions during migration)
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=
HASURA_GRAPHQL_JWT_SECRET=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_BUCKET_REGION=ap-south-1
S3_PUBLIC_BASE_URL=

# Email / SMTP
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Internal secrets
WARP_INTERNAL_SHARED_KEY=
CRON_SECRET=
HASURA_WEBHOOK_SECRET=
